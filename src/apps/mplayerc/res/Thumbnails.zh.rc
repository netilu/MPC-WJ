#include "../ThumbnailResources.h"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)
TH_DIALOG DIALOGEX 0, 0, 460, 374
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "创建缩略图"
FONT 9, "Segoe UI", 0, 0, 1
BEGIN
 GROUPBOX "文件列表", 57100, 7, 5, 446, 108
 CONTROL "", TH_FILES, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 14, 18, 432, 70
 PUSHBUTTON "添加文件...", TH_ADD, 14, 92, 70, 15
 PUSHBUTTON "移除", TH_REMOVE, 90, 92, 60, 15
 PUSHBUTTON "清空", TH_CLEAR, 156, 92, 60, 15
 GROUPBOX "输出设置", 57101, 7, 116, 446, 61
 EDITTEXT TH_DIRECTORY, 14, 128, 278, 14, ES_AUTOHSCROLL
 PUSHBUTTON "...", TH_BROWSE, 297, 128, 23, 14
 AUTOCHECKBOX "保存到视频所在目录", TH_BESIDE, 326, 129, 119, 13
 COMBOBOX TH_FORMAT, 14, 152, 65, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "JPG 品质 (%)", TH_Q_LABEL, 88, 154, 70, 12
 EDITTEXT TH_QUALITY, 159, 151, 38, 15, ES_NUMBER | ES_AUTOHSCROLL
 LTEXT "PNG 压缩等级", TH_P_LABEL, 209, 154, 82, 12
 EDITTEXT TH_COMPRESSION, 292, 151, 30, 15, ES_NUMBER | ES_AUTOHSCROLL
 AUTOCHECKBOX "输出字幕", TH_SUBTITLES, 332, 153, 108, 13
 GROUPBOX "版式（宽度为整张图片像素数）", 57102, 7, 180, 446, 41
 LTEXT "行", 57103, 14, 197, 27, 12
 EDITTEXT TH_ROWS, 42, 194, 32, 15, ES_NUMBER
 LTEXT "列", 57104, 82, 197, 25, 12
 EDITTEXT TH_COLS, 107, 194, 32, 15, ES_NUMBER
 LTEXT "宽度", 57105, 148, 197, 30, 12
 EDITTEXT TH_WIDTH, 179, 194, 45, 15, ES_NUMBER
 LTEXT "边距", 57106, 235, 197, 35, 12
 EDITTEXT TH_MARGIN, 271, 194, 32, 15, ES_NUMBER
 PUSHBUTTON "背景颜色...", TH_COLOR, 320, 194, 125, 15
 GROUPBOX "文字与标识（字号单位：输出像素）", 57107, 7, 224, 446, 65
 AUTOCHECKBOX "显示文件信息", TH_INFO, 14, 239, 105, 13
 PUSHBUTTON "Segoe UI", TH_INFOFONT, 122, 237, 171, 16
 EDITTEXT TH_INFOSIZE, 302, 238, 32, 15, ES_NUMBER
 AUTOCHECKBOX "显示 MPC-WJ 标识", TH_LOGO, 341, 239, 105, 13
 AUTOCHECKBOX "显示时间", TH_TIME, 14, 263, 105, 13
 PUSHBUTTON "Segoe UI", TH_TIMEFONT, 122, 261, 171, 16
 EDITTEXT TH_TIMESIZE, 302, 262, 32, 15, ES_NUMBER
 AUTOCHECKBOX "生成时隐藏播放画面", TH_HIDEVIDEO, 14, 294, 431, 13
 LTEXT "总进度", 57120, 14, 312, 210, 11
 LTEXT "当前视频取帧进度", 57121, 235, 312, 210, 11
 CONTROL "", TH_TOTAL, "msctls_progress32", WS_BORDER, 14, 325, 210, 8
 CONTROL "", TH_CURRENT, "msctls_progress32", WS_BORDER, 235, 325, 210, 8
 LTEXT "", TH_SUMMARY, 14, 336, 431, 12
 PUSHBUTTON "打开输出目录", TH_OPENOUTPUT, 14, 353, 99, 16
 DEFPUSHBUTTON "开始生成", TH_START, 229, 353, 70, 16
 PUSHBUTTON "取消任务", TH_CANCEL, 305, 353, 70, 16
 PUSHBUTTON "关闭", IDCANCEL, 381, 353, 65, 16
END
STRINGTABLE
BEGIN
 TH_RESOURCE_VERSION "2"
 TH_FILECOL "完整路径"
 TH_STATUSCOL "处理状态"
 TH_READY "等待"
 TH_WORKING "正在生成"
 TH_DONE "成功"
 TH_FAILED "失败"
 TH_CANCELLED "已取消"
 TH_INVALID "参数无效：请检查行列、宽度、边距、字号以及可用画面区域；像素缓冲区不得超过 512 MiB。"
 TH_OPENERROR "无法打开视频、视频不支持取帧或打开超时。"
 TH_FRAMEERROR "取帧失败或等待超过 15 秒。"
 TH_WRITEERROR "无法保存图片，请检查输出目录和写入权限。"
 TH_RESTOREERROR "无法恢复原视频，请重新打开。"
 TH_SUMMARYTEXT "成功 %u / 失败 %u / 取消 %u / 总计 %u"
 TH_WAITING "正在打开"
 TH_RESTORING "正在恢复原视频..."
 TH_LOCALONLY "请选择本地视频文件，并指定一个已存在的输出目录。"
 TH_CANCELLING "正在取消，等待当前操作安全结束…"
 TH_OPENTIMEOUT "打开视频超过 60 秒。"
END
